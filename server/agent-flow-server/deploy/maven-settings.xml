<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <!-- 容器构建期专用：国内直连 Maven Central 会拖到十分钟级，这里统一走阿里云公共仓库。
       本地开发机不需要它（~/.m2/settings.xml 已有同源配置），所以放 deploy/ 而不是仓库根。 -->
  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun Public Repository</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central,jcenter,spring-milestones</mirrorOf>
    </mirror>
  </mirrors>
</settings>
