<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.agentflow</groupId>
    <artifactId>agent-flow-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>node-adapters</artifactId>
  <name>node-adapters</name>
  <description>节点执行器实现集合（core/http/llm/image/wechat）。P2 起引入 spring-ai-alibaba-starter-dashscope 等模型依赖。</description>

  <dependencies>
    <dependency>
      <groupId>com.agentflow</groupId>
      <artifactId>workflow-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.agentflow</groupId>
      <artifactId>platform-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- http.collect 页面解析 -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
    </dependency>
    <!-- llm.chat 的 Spring AI 实现（只引 core 不引 starter：避免 autoconfigure 在无 API key 时启动即炸，网关 Bean 由 server 装配层条件化控制） -->
    <dependency>
      <groupId>com.alibaba.cloud.ai</groupId>
      <artifactId>spring-ai-alibaba-core</artifactId>
      <exclusions>
        <!-- 本项目不接 Nacos 配置中心。这个传递依赖会注册健康指标，在无 Nacos 时把
             /actuator/health 整体拉成 DOWN；排除后仅保留 DashScopeApi 真正用到的 nacos-client。 -->
        <exclusion>
          <groupId>com.alibaba.cloud</groupId>
          <artifactId>spring-alibaba-nacos-config</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- DashScopeApi 的构造与请求拼装调用 com.alibaba.nacos.common.utils.StringUtils（在 nacos-client 内），
         所以这个 jar 不能一起排掉；版本与被排除的 config 客户端保持一致。 -->
    <dependency>
      <groupId>com.alibaba.nacos</groupId>
      <artifactId>nacos-client</artifactId>
      <version>2.4.2</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
